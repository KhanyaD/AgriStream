{
  "version": "2.0",
  "logging": {
    "applicationInsights": { "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" } },
    "logLevel": { "default": "Information", "Host.Results": "Information", "Function": "Information" }
  },
  "extensions": {
    "queues": { "batchSize": 16, "newBatchThreshold": 8, "maxDequeueCount": 5, "visibilityTimeout": "00:01:00" }
  }
}
