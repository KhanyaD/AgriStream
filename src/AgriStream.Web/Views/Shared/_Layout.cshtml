<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>AgriStream IoT</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">AgriStream IoT</a><nav>@if(User.Identity?.IsAuthenticated==true){<span>@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>@if(User.IsInRole("Admin")){<a asp-controller="Account" asp-action="CreateUser">Manage users</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Sign out</button></form>}</nav></header><main>@if(TempData["Message"] is string message){<div class="notice success">@message</div>}@if(TempData["Error"] is string error){<div class="notice error">@error</div>}@RenderBody()</main><footer>Real-time farm monitoring and irrigation management</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
