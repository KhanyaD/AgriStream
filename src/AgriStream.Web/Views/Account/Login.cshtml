@model LoginModel
<section class="card narrow"><p class="eyebrow">SECURE ACCESS</p><h1>Sign in</h1><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Username<input asp-for="Username" autocomplete="username"/></label><label>Password<input asp-for="Password" autocomplete="current-password"/></label><button>Sign in</button></form><p>First visit? <a asp-action="Setup">Create the initial administrator account</a>.</p></section>
