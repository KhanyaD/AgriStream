@model CreateUserModel
<section class="card narrow"><h1>Create user</h1><form asp-action="CreateUser" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Username<input asp-for="Username"/></label><label>Password (at least 12 characters)<input asp-for="Password" autocomplete="new-password"/></label><label>Role<select asp-for="Role"><option>Farmer</option><option>Agronomist</option><option>Admin</option></select></label><button>Create account</button></form></section>
