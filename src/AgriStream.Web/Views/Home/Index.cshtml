@{ var rows = ViewBag.Telemetry as IEnumerable<TelemetryRecord> ?? Array.Empty<TelemetryRecord>(); }
<section class="hero"><p class="eyebrow">FIELD OPERATIONS</p><h1>Farm telemetry dashboard</h1><p>Review sensor readings, upload drone imagery, and queue irrigation commands.</p></section>
<div class="grid two">
<section class="card"><h2>Add sensor reading</h2><form asp-action="AddTelemetry" method="post"><label>Farm ID<input name="FarmId" required maxlength="100" placeholder="farm-001"/></label><label>Device ID<input name="DeviceId" required maxlength="100" placeholder="sensor-001"/></label><div class="grid two"><label>Soil moisture (%)<input name="SoilMoisture" type="number" min="0" max="100" step="0.1" required/></label><label>Temperature (°C)<input name="TemperatureC" type="number" min="-50" max="80" step="0.1" required/></label></div><label>Humidity (%)<input name="HumidityPercent" type="number" min="0" max="100" step="0.1" required/></label><button>Save telemetry</button></form></section>
<section class="card"><h2>Upload drone image</h2><p>Images are stored privately in Azure Blob Storage. The Blob-triggered Function writes the upload audit record.</p><form asp-action="UploadImage" method="post" enctype="multipart/form-data"><label>Image file<input type="file" name="image" accept="image/*" required/></label><button>Upload image</button></form><hr/><h2>Queue irrigation</h2><form asp-action="Irrigate" method="post"><label>Farm ID<input name="FarmId" required maxlength="100" placeholder="farm-001"/></label><label>Device ID<input name="DeviceId" required maxlength="100" placeholder="valve-001"/></label><label>Duration (minutes)<input name="DurationMinutes" type="number" min="1" max="360" value="10" required/></label><button>Queue command</button></form></section></div>
<section class="card"><div class="row"><div><h2>Recent telemetry — @ViewBag.FarmId</h2><p>Latest readings from the selected farm partition in Azure Table Storage.</p></div><a class="button secondary" href="/Home/Latest?farmId=@ViewBag.FarmId">Function GET endpoint</a></div>@if(ViewBag.StorageError is string storageError){<p class="notice error">@storageError</p>}<div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>Farm</th><th>Device</th><th>Soil moisture</th><th>Temp °C</th><th>Humidity</th></tr></thead><tbody>@foreach(var item in rows){<tr><td>@item.RecordedAt.ToString("u")</td><td>@item.FarmId</td><td>@item.DeviceId</td><td>@item.SoilMoisture%</td><td>@item.TemperatureC</td><td>@item.HumidityPercent%</td></tr>}@if(!rows.Any()){<tr><td colspan="6">No readings for this farm yet. Add a reading with Farm ID farm-001.</td></tr>}</tbody></table></div></section>
